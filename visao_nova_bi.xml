	<modelPath>/content/folder[@name=&apos;SCI Data Packages&apos;]/folder[@name=&apos;Operational Packages&apos;]/folder[@name=&apos;Warehouse Management OS&apos;]/package[@name=&apos;MVGPA_Shipping&apos;]/model[@name=&apos;model&apos;]</modelPath>

	<!-- ═══════════════════════════════════ -->
	<!--  QUERIES — Ajuste o SQL conforme XLSX  -->
	<!-- ═══════════════════════════════════ -->
	<queries>
		<query name="Consulta_Dados">
			<source>
				<sqlQuery name="SQL1" dataSource="WMOS" type="passThrough">
					<sqlText>SELECT
    FACILITY_ALIAS_ID AS CD,
    CAST(CREATED_DTTM AS DATE) AS DATA,
    CASE
        WHEN STAT_CODE &gt;= 90 THEN &apos;CONCLUIDO&apos;
        WHEN STAT_CODE &gt;= 30 THEN &apos;EM_ANDAMENTO&apos;
        ELSE &apos;PENDENTE&apos;
    END AS STATUS,
    &apos;OPERACAO&apos; AS OPERACAO,
    COUNT(*) AS QUANTIDADE,
    SUM(TOTAL_VALUE) AS VALOR
FROM SHIPMENT
WHERE 1=1
  #prompt(&apos;p_CD&apos;, &apos;string&apos;, &apos;TODOS&apos;)# &lt;&gt; &apos;TODOS&apos;
  AND (#prompt(&apos;p_CD&apos;, &apos;string&apos;, &apos;TODOS&apos;)# = &apos;TODOS&apos; OR FACILITY_ALIAS_ID = #prompt(&apos;p_CD&apos;, &apos;string&apos;, &apos;TODOS&apos;)#)
  AND (#prompt(&apos;p_data_inicio&apos;, &apos;date&apos;, &apos;&apos;)# IS NULL OR CAST(CREATED_DTTM AS DATE) &gt;= #prompt(&apos;p_data_inicio&apos;, &apos;date&apos;, &apos;&apos;)#)
  AND (#prompt(&apos;p_data_fim&apos;, &apos;date&apos;, &apos;&apos;)# IS NULL OR CAST(CREATED_DTTM AS DATE) &lt;= #prompt(&apos;p_data_fim&apos;, &apos;date&apos;, &apos;&apos;)#)
  AND (#prompt(&apos;p_Status&apos;, &apos;string&apos;, &apos;TODOS&apos;)# = &apos;TODOS&apos; OR
       CASE
           WHEN STAT_CODE &gt;= 90 THEN &apos;CONCLUIDO&apos;
           WHEN STAT_CODE &gt;= 30 THEN &apos;EM_ANDAMENTO&apos;
           ELSE &apos;PENDENTE&apos;
       END = #prompt(&apos;p_Status&apos;, &apos;string&apos;, &apos;TODOS&apos;)#)
GROUP BY FACILITY_ALIAS_ID, CAST(CREATED_DTTM AS DATE), STAT_CODE
ORDER BY DATA DESC, CD</sqlText>
				</sqlQuery>
			</source>
			<selection>
				<dataItem name="CD"><expression>[SQL1].[CD]</expression></dataItem>
				<dataItem name="DATA"><expression>[SQL1].[DATA]</expression></dataItem>
				<dataItem name="OPERACAO"><expression>[SQL1].[OPERACAO]</expression></dataItem>
				<dataItem name="STATUS"><expression>[SQL1].[STATUS]</expression></dataItem>
				<dataItem name="QUANTIDADE"><expression>[SQL1].[QUANTIDADE]</expression></dataItem>
				<dataItem name="VALOR"><expression>[SQL1].[VALOR]</expression></dataItem>
			</selection>
			<queryHints><localCache value="false"/><queryProcessing value="databaseOnly"/></queryHints>
		</query>

		<query name="Consulta_KPI">
			<source><queryRef refQuery="Consulta_Dados"/></source>
			<selection>
				<dataItem name="TOTAL_REGISTROS" aggregate="total" rollupAggregate="none">
					<expression>total([Consulta_Dados].[QUANTIDADE] for report)</expression>
				</dataItem>
				<dataItem name="TOTAL_CONCLUIDOS" aggregate="total" rollupAggregate="none">
					<expression>total(case when [Consulta_Dados].[STATUS] = &apos;CONCLUIDO&apos; then [Consulta_Dados].[QUANTIDADE] else 0 end for report)</expression>
				</dataItem>
				<dataItem name="TOTAL_EM_ANDAMENTO" aggregate="total" rollupAggregate="none">
					<expression>total(case when [Consulta_Dados].[STATUS] = &apos;EM_ANDAMENTO&apos; then [Consulta_Dados].[QUANTIDADE] else 0 end for report)</expression>
				</dataItem>
				<dataItem name="TOTAL_PENDENTES" aggregate="total" rollupAggregate="none">
					<expression>total(case when [Consulta_Dados].[STATUS] = &apos;PENDENTE&apos; then [Consulta_Dados].[QUANTIDADE] else 0 end for report)</expression>
				</dataItem>
			</selection>
			<queryHints><localCache value="false"/><queryProcessing value="databaseOnly"/></queryHints>
		</query>
	</queries>


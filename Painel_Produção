	<reportName>Prod_v3</reportName>
	<modelPath>/content/folder[@name=&apos;SCI Data Packages&apos;]/folder[@name=&apos;Operational Packages&apos;]/folder[@name=&apos;Warehouse Management OS&apos;]/package[@name=&apos;Labor_MJVO&apos;]/model[@name=&apos;model&apos;]</modelPath>
	<queries>
		<query name="Base">
			<source>
				<sqlQuery name="SQL1" dataSource="WMOS">
					<sqlText>WITH BASE_TRANSACTIONS AS (
    -- Isolamos a leitura da PROD_TRKG_TRAN aqui para o banco ler e calcular os turnos apenas UMA VEZ.
    SELECT 
        PTT.TASK_ID,
        PTT.USER_ID,
        PTT.ITEM_ID,
        PTT.NBR_UNITS,
        PTT.CNTR_NBR,
        PTT.LINE_ITEM_ID,
        PTT.TC_ORDER_ID,
        PTT.MOD_DATE_TIME,
        PTT.CREATE_DATE_TIME,
        PTT.MENU_OPTN_NAME,
        PTT.FROM_LOCN,
        TH.INVN_TYPE AS TH_INVN_TYPE,
        TH.WHSE AS TH_WHSE,
        TH.INVN_NEED_TYPE AS TH_INVN_NEED_TYPE
    FROM PROD_TRKG_TRAN PTT
    JOIN TASK_HDR TH ON TH.TASK_ID = PTT.TASK_ID
    WHERE PTT.TRAN_TYPE = 500
      AND TH.INVN_NEED_TYPE != 2
      AND CASE WHEN TH.INVN_TYPE = &apos;H&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt;=22 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;MI&apos;) AS FLOAT)&gt;30 THEN 3 
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt;=23 THEN 3 
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;12 THEN 1        
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&gt;=12  AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;13 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;MI&apos;) AS FLOAT)&lt;=45 THEN 1                    
            ELSE 2 END
        WHEN TH.INVN_TYPE = &apos;J&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 6 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 18 THEN 1
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 22 OR CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
            ELSE NULL END
        ELSE
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt; 21 THEN 3     
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;14  THEN 1        
            ELSE 2 END
        END = 
        CASE WHEN TH.INVN_TYPE = &apos;H&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;=22 AND CAST(TO_CHAR(SYSDATE,&apos;MI&apos;) AS FLOAT)&gt;30 THEN 3 
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;=23 THEN 3 
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;12 THEN 1        
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&gt;=12  AND CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;13 AND CAST(TO_CHAR(SYSDATE,&apos;MI&apos;) AS FLOAT)&lt;=45 THEN 1                    
            ELSE 2 END
        WHEN TH.INVN_TYPE = &apos;J&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(SYSDATE, &apos;HH24&apos;) AS FLOAT) &gt;= 6 AND CAST(TO_CHAR(SYSDATE, &apos;HH24&apos;) AS FLOAT) &lt; 18 THEN 1
                WHEN CAST(TO_CHAR(SYSDATE, &apos;HH24&apos;) AS FLOAT) &gt;= 22 OR CAST(TO_CHAR(SYSDATE, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
            ELSE NULL END
        ELSE
            CASE
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt; 21 THEN 3     
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;14  THEN 1        
            ELSE 2 END
        END
      AND (CASE
            WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN TRUNC(PTT.MOD_DATE_TIME)-1
            ELSE TRUNC(PTT.MOD_DATE_TIME)
          END) = 
          (CASE
            WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN TRUNC(SYSDATE)-1
            ELSE TRUNC(SYSDATE)
          END)
)
SELECT
    ROWNUM AS LINHA,
    D.USER_ID,

    SUBSTR(
        D.COLABORADOR,
        INSTR(D.COLABORADOR, &apos;-&apos;) + 1,
        INSTR(D.COLABORADOR, &apos;[&apos;) - INSTR(D.COLABORADOR, &apos;-&apos;) - 1
    ) AS ID_COLABORADOR,

    SUBSTR(
        D.COLABORADOR,
        1,
        INSTR(SUBSTR(D.COLABORADOR, 1, INSTR(D.COLABORADOR, &apos;[&apos;) - 1), &apos;-&apos;, -1) - 1
    ) AS COLABORADOR,

    SUBSTR(
        D.COLABORADOR,
        INSTR(D.COLABORADOR, &apos;[&apos;) + 1,
        INSTR(D.COLABORADOR, &apos;]&apos;) - INSTR(D.COLABORADOR, &apos;[&apos;) - 1
    ) AS HORARIO,

    D.QTY_HORAS,
    D.QTY_CXS_SEP,
    D.&quot;ATUALIZAÇÃO&quot;,
    D.TURNO,
    D.OPE,
    D.OPERACAO,
    D.HORA_TURNO,
    D.QTY_CORTE_CXS,
    D.TEMPO,
    D.RANK
FROM 
((SELECT  
    C.RANK,
    C.USER_ID,
    C.COLABORADOR,
    C.QTY_HORAS,
    C.PROD_HORA,
    C.QTY_CXS_SEP,
    C.&quot;ATUALIZAÇÃO&quot;,
    C.TURNO,
    C.OPE,
    C.OPERACAO,
    CASE 
        WHEN C.OPERACAO=&apos;CD 1942&apos; THEN 
            CASE 
                WHEN C.TURNO=1 THEN 6.25
                WHEN C.TURNO=2 THEN 9.73
                ELSE 7.48
            END
       ELSE
            CASE 
                WHEN C.TURNO=1 THEN 7.0
                WHEN C.TURNO=2 THEN 7.0
                ELSE 7.0
            END
    END AS HORA_TURNO,
    0 AS QTY_CORTE_CXS,
    TEMPO_PEGA.TEMPO
FROM
((SELECT  
        RANK() OVER(ORDER BY B.QTY_CXS_SEP DESC) AS RANK,
        B.USER_ID,
        B.COLABORADOR ||&apos;[&apos;|| TO_CHAR(B.MENOR_PEGA,&apos;HH24:MI&apos;)||&apos;-&apos;||TO_CHAR(B.ULTIMA_PEGA,&apos;HH24:MI&apos;)||&apos;]&apos; AS COLABORADOR,
        B.QTY_HORAS,
        B.PROD_HORA,
        B.QTY_CXS_SEP,
        B.&quot;ATUALIZAÇÃO&quot;,
        B.TURNO,
        B.OPE,
        B.OPERACAO
    FROM    
    ((SELECT    
        A.USER_ID,
        UPPER(A.COLABORADOR) AS COLABORADOR,
        A.QTY_HORAS,
        A.QTY_CXS_SEP,
        A.PROD_HORA,
        A.MENOR_PEGA,
        A.ULTIMA_PEGA,
        TO_CHAR(SYSDATE,&apos;DD/MM/YYYY HH24:MI&apos;) AS &quot;ATUALIZAÇÃO&quot;,
        A.TURNO,
        A.OPE,
        A.OPERACAO
    FROM
    ((SELECT   
        A.USER_ID,
        A.COLABORADOR,
        A.TURNO,
        A.OPERACAO,
        A.OPE,
        MIN(A.MENOR_PEGA) AS MENOR_PEGA,
        MAX(A.ULTIMA_PEGA) AS ULTIMA_PEGA,    
        COUNT(DISTINCT A.HORA) AS QTY_HORAS,
        SUM(A.QTY_CXS_SEP) AS QTY_CXS_SEP,
        ROUND(SUM(A.QTY_CXS_SEP) / COUNT(DISTINCT A.HORA)) AS PROD_HORA
    FROM    
    ((SELECT
        CD.CD,
        PRO_FINAL.DT_SEP AS DATA_PRODUCAO,
        PRO_FINAL.USER_ID,
        UU.USER_FIRST_NAME||&apos; &apos;||USER_LAST_NAME ||&apos;-&apos;|| PRO_FINAL.USER_ID as COLABORADOR,
        PRO_FINAL.&quot;TURNO DE CADASTRO&quot;,
        CASE 
            WHEN PRO_FINAL.TURNO=1 THEN &apos;1º Turno&apos;
            WHEN PRO_FINAL.TURNO=2 THEN &apos;2º Turno&apos;
            ELSE &apos;3º Turno&apos;
        END AS TURNO_DATA,    
        PRO_FINAL.HORA,
        PRO_FINAL.QTY_CXS_SEP AS PRODUCAO,
        PRO_FINAL.QTY_CXS_PLT,
        PRO_FINAL.QTY_CXS_SEP_PICKING AS QTY_CXS_SEP,
        PRO_FINAL.PRODUTIVIDADE,
        PRO_FINAL.EMPRESA,
        PRO_FINAL.INVN_TYPE,
        PRO_FINAL.WHSE,
        PRO_FINAL.OPE,
        PRO_FINAL.CODE_DESC,
        CASE WHEN PRO_FINAL.CODE_DESC IS NULL THEN &apos;CD &apos;|| CD.CD ELSE  PRO_FINAL.CODE_DESC END AS OPERACAO,
        CASE
                WHEN PRO_FINAL.WHSE IN(&apos;CCE&apos;,&apos;CDF&apos;,&apos;CPE&apos;) THEN 
                    CASE 
                        WHEN PRO_FINAL.CATEGORIA=&apos;F.L.V&apos; THEN &apos;F.L.V&apos;
                        WHEN PRO_FINAL.CATEGORIA=&apos;CARNES&apos; THEN &apos;CARNES&apos;
                        ELSE  &apos;MERCEARIA&apos;
                        END
                WHEN PRO_FINAL.WHSE IN(&apos;CRJ&apos;) THEN 
                CASE 
                    WHEN PRO_FINAL.CATEGORIA IN(&apos;F.L.V&apos;,&apos;INSUMO PAD/CHOCOLATES&apos;) THEN &apos;F.L.V&apos;                
                    WHEN PRO_FINAL.CATEGORIA=&apos;CARNES&apos; THEN &apos;CARNES&apos;
                ELSE  &apos;MERCEARIA&apos;
                END            
        ELSE 
            &apos;GERAL&apos;
        END AS CATEGORIA,
        PRO_FINAL.MENOR_PEGA AS MENOR_PEGA,
        PRO_FINAL.ULTIMA_PEGA AS ULTIMA_PEGA,
        PRO_FINAL.TURNO    
    FROM    
    ((SELECT 
        PRD_WMS.DT_SEP,
        PRD_WMS.USER_ID,
        PRDTY_LABOR.&quot;TURNO&quot; AS &quot;TURNO DE CADASTRO&quot;,
        PRDTY_LABOR.EMPRESA,
        PRD_WMS.HORA,
        PRD_WMS.TURNO,
        PRD_WMS.QTY_CXS_SEP,
        PRDTY_LABOR.PRODUTIVIDADE,
        PRD_WMS.INVN_TYPE,
        PRD_WMS.WHSE,
        PRD_WMS.OPE,
        PRD_WMS.CODE_DESC,
        PRD_WMS.CATEGORIA,
        PRD_WMS.QTY_CXS_PLT,
        PRD_WMS.QTY_CXS_SEP_PICKING,
        PRD_WMS.MENOR_PEGA AS MENOR_PEGA,
        PRD_WMS.ULTIMA_PEGA AS ULTIMA_PEGA    
    FROM  
    ((SELECT 
         PROD.DT_SEP,
         PROD.USER_ID,
         PROD.INVN_TYPE,
         PROD.WHSE,
         PROD.CODE_DESC,
         CASE
            WHEN PROD.HORA=22 THEN  &apos;1- 22h&apos;
            WHEN PROD.HORA=23 THEN  &apos;2- 23h&apos;
            WHEN PROD.HORA=0 THEN   &apos;3- 0h&apos;
            WHEN PROD.HORA=1 THEN   &apos;4- 1h&apos;
            WHEN PROD.HORA=2 THEN   &apos;5- 2h&apos;
            WHEN PROD.HORA=3 THEN   &apos;6- 3h&apos;
            WHEN PROD.HORA=4 THEN   &apos;7- 4h&apos;
            WHEN PROD.HORA=5 THEN   &apos;8- 5h&apos;
            WHEN PROD.HORA=6 THEN   &apos;1- 6h&apos;
            WHEN PROD.HORA=7 THEN   &apos;2- 7h&apos;
            WHEN PROD.HORA=8 THEN   &apos;3- 8h&apos;
            WHEN PROD.HORA=9 THEN   &apos;4- 9h&apos;
            WHEN PROD.HORA=10 THEN  &apos;5- 10h&apos;
            WHEN PROD.HORA=11 THEN  &apos;6- 11h&apos;
            WHEN PROD.HORA=12 THEN  &apos;7- 12h&apos;
            WHEN PROD.HORA=13 THEN  &apos;8- 13h&apos;
            WHEN PROD.HORA=14 THEN  &apos;1- 14h&apos;
            WHEN PROD.HORA=15 THEN  &apos;2- 15h&apos;
            WHEN PROD.HORA=16 THEN  &apos;3- 16h&apos;
            WHEN PROD.HORA=17 THEN  &apos;4- 17h&apos;
            WHEN PROD.HORA=18 THEN  &apos;5- 18h&apos;
            WHEN PROD.HORA=19 THEN  &apos;6- 19h&apos;
            WHEN PROD.HORA=20 THEN  &apos;7- 20h&apos;
            ELSE   &apos;8- 21h&apos;
         END AS HORA,
         PROD.CATEGORIA,
         PROD.TURNO,
         PROD.OPE,
         MIN(PROD.DATA_HORA) AS MENOR_PEGA,
         MAX(PROD.DATA_HORA) AS ULTIMA_PEGA,     
         ROUND(SUM(PROD.QTY_CXS),0) AS QTY_CXS_SEP,
         ROUND(SUM(PROD.QTY_CXS_PLT),0) AS QTY_CXS_PLT,
         ROUND(SUM(PROD.QTY_CXS_SEP),0) AS QTY_CXS_SEP_PICKING
    FROM
       ((SELECT             
                PTT.CREATE_DATE_TIME AS DATA_HORA,            
                CASE
                  WHEN CAST(TO_CHAR(PTT.CREATE_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN TRUNC(PTT.CREATE_DATE_TIME)-1
                  ELSE TRUNC(PTT.CREATE_DATE_TIME)    
                END AS DT_SEP,
                CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) AS HORA,    
                CASE WHEN PTT.TH_INVN_TYPE = &apos;H&apos; THEN
                    CASE
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 22 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;MI&apos;) AS FLOAT) &gt; 30 THEN 3
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 23 THEN 3
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 12 THEN 1
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 12 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 13 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;MI&apos;) AS FLOAT) &lt;= 45 THEN 1
                    ELSE 2
                    END
                WHEN PTT.TH_INVN_TYPE = &apos;J&apos; THEN
                    CASE
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 6 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 18 THEN 1
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 22 OR CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                    ELSE NULL 
                    END
                ELSE
                    CASE
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt; 21 THEN 3
                        WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 14 THEN 1
                    ELSE 2
                    END
                END AS TURNO,
                CASE WHEN PTT.TH_INVN_TYPE = &apos;H&apos; THEN
                    CASE
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;= 22 AND CAST(TO_CHAR(SYSDATE,&apos;MI&apos;) AS FLOAT) &gt; 30 THEN 3 
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;= 23 THEN 3 
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 12 THEN 1        
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;= 12 AND CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 13 AND CAST(TO_CHAR(SYSDATE,&apos;MI&apos;) AS FLOAT) &lt;= 45 THEN 1                    
                    ELSE 2    
                    END
                WHEN PTT.TH_INVN_TYPE = &apos;J&apos; THEN
                    CASE
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt;= 6 AND CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 18 THEN 1
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt; 22 OR CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                    ELSE NULL 
                    END
                ELSE
                    CASE
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &gt; 21 THEN 3     
                        WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT) &lt; 14 THEN 1        
                    ELSE 2    
                    END 
                END AS TURNO_ATUAL,                
                PTT.TH_INVN_NEED_TYPE,
                CASE WHEN (LENGTH(PTT.TH_INVN_TYPE)=0) OR PTT.TH_INVN_TYPE IS NULL OR (LENGTH(PTT.TH_INVN_TYPE)&gt;0 AND PTT.TH_INVN_TYPE!=&apos;G&apos;) THEN &apos;G&apos; ELSE PTT.TH_INVN_TYPE END AS INVN_TYPE,
                PTT.TH_WHSE AS WHSE,
                SC.CODE_DESC,
                SUBSTR(PTT.TC_ORDER_ID,1,5) AS PRX_PED,
                CASE  
                    WHEN PTT.TH_INVN_NEED_TYPE=2 THEN &apos;PLT Fechado&apos;
                    WHEN SUBSTR(PTT.TC_ORDER_ID,1,5)=&apos;DOFTX&apos; THEN &apos;Separação Fatex&apos;
                    ELSE &apos;Separação &apos; || DADOS_ITEM.CATEGORIA
                END AS TASK_DESC,
                PTT.TASK_ID,
                PTT.USER_ID,
                PTT.ITEM_ID,
                cd.OPE,
                DADOS_ITEM.CATEGORIA,
                DADOS_ITEM.ITEM_NAME,            
                PTT.NBR_UNITS,
                ROUND(PTT.NBR_UNITS/DADOS_ITEM.EMB_FINAL,3) AS QTY_CXS,
                CASE WHEN (CASE  
                    WHEN PTT.TH_INVN_NEED_TYPE=2 THEN &apos;PLT Fechado&apos;
                    WHEN SUBSTR(PTT.TC_ORDER_ID,1,5)=&apos;DOFTX&apos; THEN &apos;Separação Fatex&apos;
                    ELSE &apos;Separação &apos; || DADOS_ITEM.CATEGORIA
                END)=&apos;PLT Fechado&apos; THEN ROUND(PTT.NBR_UNITS/DADOS_ITEM.EMB_FINAL,3) ELSE 0 END QTY_CXS_PLT,
                CASE 
                    WHEN PTT.NBR_UNITS &lt; DADOS_ITEM.EMB_FINAL AND oli.QTY_UOM_ID != &apos;253&apos; THEN PTT.NBR_UNITS
                    WHEN (CASE  
                        WHEN PTT.TH_INVN_NEED_TYPE=2 THEN &apos;PLT Fechado&apos;
                        WHEN SUBSTR(PTT.TC_ORDER_ID,1,5)=&apos;DOFTX&apos; THEN &apos;Separação Fatex&apos;
                        ELSE &apos;Separação &apos; || DADOS_ITEM.CATEGORIA
                    END)!=&apos;PLT Fechado&apos; THEN ROUND(PTT.NBR_UNITS/DADOS_ITEM.EMB_FINAL,3) ELSE 0 END QTY_CXS_SEP        
        FROM BASE_TRANSACTIONS PTT  
        LEFT JOIN lpn l ON ptt.CNTR_NBR = l.tc_lpn_id
        LEFT JOIN ORDER_LINE_ITEM oli ON ptt.LINE_ITEM_ID = oli.LINE_ITEM_ID
        LEFT JOIN
            (SELECT 
                ld.LPN_ID,
                sc.CODE_ID,
                sc.CODE_DESC OPE
             FROM SYS_CODE sc
             JOIN LPN_DETAIL ld ON ld.INVENTORY_TYPE=sc.CODE_ID
             WHERE sc.CODE_TYPE=&apos;064&apos;
             GROUP BY ld.LPN_ID, sc.CODE_ID, sc.CODE_DESC) cd 
        ON l.lpn_id = cd.lpn_id   
        JOIN
            ((SELECT
                DI.ITEM_ID,
                DI.ITEM_NAME,
                DI.COMPRADOR,
                DI.ITEM,
                DI.PRODUCT_CLASS_ID,
                DI.BASE_UOM,
                DI.QTY_UOM,
                DI.CATEGORIA,
                DI.SHELF_DAYS,
                CASE WHEN DI.VARIABLE_WEIGHT=1 THEN PV.EMB_PS_VAR ELSE DI.EMB_FINAL END AS EMB_FINAL,
                DI.BASE,
                DI.ALTURA,
                DI.PALETIZACAO
        FROM
        ((SELECT
                ITEM_RES.ITEM_ID,
                ITEM_RES.ITEM_NAME,
                ITEM_RES.COMPRADOR,
                ITEM_RES.DESCRIPTION AS ITEM,
                ITEM_RES.DSP_LOCN,
                ITEM_RES.PRODUCT_CLASS_ID,
                ITEM_RES.EMBALAGEM,
                ITEM_RES.BASE_UOM,
                ITEM_RES.QTY_UOM,
                ITEM_RES.UOM_PKT,
                ITEM_RES.CATEGORIA,
                ITEM_RES.SHELF_DAYS,
                ITEM_RES.EMB_FINAL,
                ITEM_RES.BASE,
                ITEM_RES.ALTURA,
                ITEM_RES.PALETIZACAO,
                ITEM_RES.UNIT_COST,
                ITEM_RES.DATA_AT,
                ITEM_RES.VARIABLE_WEIGHT                            
        FROM
        ((SELECT 
            IC.ITEM_ID,    
            IC.ITEM_NAME,
            IC.REF_FIELD8 AS COMPRADOR,
            IC.DESCRIPTION AS DESCRIPTION,
            LOC_PIKING.DSP_LOCN,
            IC.PRODUCT_CLASS_ID,
            IC.VARIABLE_WEIGHT,
            CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN IPC.QUANTITY ELSE EMB_PADRAO.QUANTITY END AS EMBALAGEM, 
            IPC.IS_STD,        
            EMB_PADRAO.IS_STD AS EMB_STD,
            UB.DESCRIPTION AS BASE_UOM,
            UQ.DESCRIPTION AS QTY_UOM,
            CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN UP.DESCRIPTION ELSE EMB_PADRAO.UOM_PKT END AS UOM_PKT,
            PC.DESCRIPTION AS CATEGORIA,
            IFMW.SHELF_DAYS,
            CASE                
                WHEN UQ.DESCRIPTION=&apos;Unidades&apos; THEN 1
                WHEN IPC.QUANTITY IS NULL  AND UB.DESCRIPTION=&apos;Gramas&apos; THEN 1000
                WHEN IPC.QUANTITY IS NULL AND UB.DESCRIPTION=&apos;Unidades&apos; THEN 1
                ELSE CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN IPC.QUANTITY ELSE EMB_PADRAO.QUANTITY END 
            END AS EMB_FINAL,                        
            IFMW.LPN_PER_TIER BASE,
            IFMW.TIER_PER_PLT ALTURA,
            IFMW.LPN_PER_TIER * IFMW.TIER_PER_PLT AS PALETIZACAO,
            CUSTO.UNIT_COST,
            CUSTO.DATA_AT
        FROM ITEM_CBO IC
        LEFT JOIN ITEM_PACKAGE_CBO IPC ON IC.ITEM_ID=IPC.ITEM_ID
        LEFT JOIN SIZE_UOM UB ON IC.BASE_STORAGE_UOM_ID=UB.SIZE_UOM_ID
        LEFT JOIN SIZE_UOM UQ ON IC.DISPLAY_QTY_UOM_ID=UQ.SIZE_UOM_ID
        LEFT JOIN SIZE_UOM UP ON IPC.PACKAGE_UOM_ID=UP.SIZE_UOM_ID
        LEFT JOIN PRODUCT_CLASS PC ON PC.PRODUCT_CLASS_ID=IC.PRODUCT_CLASS_ID
        LEFT JOIN
            (SELECT PLD.LOCN_ID, PLD.ITEM_ID, LH.DSP_LOCN
             FROM LOCN_HDR LH
             LEFT JOIN PICK_LOCN_DTL PLD ON LH.LOCN_ID=PLD.LOCN_ID) LOC_PIKING
        ON IC.ITEM_ID=LOC_PIKING.ITEM_ID
        LEFT JOIN ITEM_FACILITY_MAPPING_WMS IFMW ON IFMW.ITEM_ID=IC.ITEM_ID        
        LEFT JOIN
            (SELECT ITEM_ID, UNIT_COST, DATA_AT
             FROM (
                 SELECT ITEM_ID, UNIT_COST, AUDIT_LAST_UPDATED_DTTM AS DATA_AT,
                        ROW_NUMBER() OVER(PARTITION BY ITEM_ID ORDER BY AUDIT_LAST_UPDATED_DTTM DESC) as rn
                 FROM ITEM_COST_CBO
             ) WHERE rn = 1) CUSTO
        ON CUSTO.ITEM_ID=IC.ITEM_ID
        LEFT JOIN
            (SELECT ITEM_ID, UOM_PKT, QUANTITY, WEIGHT, VOLUME, IS_STD, MARK_FOR_DELETION
             FROM (
                SELECT
                    IPC.ITEM_ID,
                    UP.DESCRIPTION AS UOM_PKT,
                    IPC.QUANTITY,
                    IPC.WEIGHT,
                    IPC.VOLUME,
                    IPC.IS_STD,
                    IPC.MARK_FOR_DELETION,
                    ROW_NUMBER() OVER (
                        PARTITION BY IPC.ITEM_ID 
                        ORDER BY CASE WHEN UP.DESCRIPTION = &apos;Subpack&apos; THEN 1 ELSE 2 END ASC,
                                 IPC.QUANTITY DESC
                    ) AS RN
                FROM ITEM_PACKAGE_CBO IPC
                JOIN SIZE_UOM UP ON IPC.PACKAGE_UOM_ID = UP.SIZE_UOM_ID
                WHERE IPC.MARK_FOR_DELETION = 0
                  AND IPC.IS_STD = 1
             )
             WHERE RN = 1) EMB_PADRAO
        ON EMB_PADRAO.ITEM_ID=IC.ITEM_ID
        GROUP BY
            IC.ITEM_ID, IC.ITEM_NAME, IC.VARIABLE_WEIGHT, IC.REF_FIELD8, IC.DESCRIPTION, IC.PRODUCT_CLASS_ID,
            CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN IPC.QUANTITY ELSE EMB_PADRAO.QUANTITY END,
            IPC.IS_STD, EMB_PADRAO.IS_STD, UB.DESCRIPTION, UQ.DESCRIPTION, UP.DESCRIPTION, PC.DESCRIPTION,
            IFMW.SHELF_DAYS, LOC_PIKING.DSP_LOCN, IFMW.LPN_PER_TIER, IFMW.TIER_PER_PLT,
            IFMW.LPN_PER_TIER * IFMW.TIER_PER_PLT,
            CASE
                WHEN UQ.DESCRIPTION=&apos;Unidades&apos; THEN 1
                WHEN IPC.QUANTITY IS NULL  AND UB.DESCRIPTION=&apos;Gramas&apos; THEN 1000
                WHEN IPC.QUANTITY IS NULL AND UB.DESCRIPTION=&apos;Unidades&apos; THEN 1
                ELSE CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN IPC.QUANTITY ELSE EMB_PADRAO.QUANTITY END
            END,
            CASE WHEN EMB_PADRAO.IS_STD IS NULL THEN UP.DESCRIPTION ELSE EMB_PADRAO.UOM_PKT END,
            CUSTO.UNIT_COST, CUSTO.DATA_AT
        ) ITEM_RES)
        GROUP BY
            ITEM_RES.ITEM_ID, ITEM_RES.ITEM_NAME, ITEM_RES.VARIABLE_WEIGHT, ITEM_RES.COMPRADOR, ITEM_RES.DESCRIPTION,
            ITEM_RES.DSP_LOCN, ITEM_RES.PRODUCT_CLASS_ID, ITEM_RES.EMBALAGEM, ITEM_RES.BASE_UOM, ITEM_RES.QTY_UOM,
            ITEM_RES.UOM_PKT, ITEM_RES.CATEGORIA, ITEM_RES.SHELF_DAYS, ITEM_RES.EMB_FINAL, ITEM_RES.BASE,
            ITEM_RES.ALTURA, ITEM_RES.PALETIZACAO, ITEM_RES.UNIT_COST, ITEM_RES.DATA_AT
    ) DI)
    LEFT JOIN
        (SELECT IC.ITEM_ID, IC.VARIABLE_WEIGHT, MAX(IPC.QUANTITY) AS EMB_PS_VAR
         FROM ITEM_CBO IC, ITEM_PACKAGE_CBO IPC
         WHERE IC.ITEM_ID=IPC.ITEM_ID
           AND IC.VARIABLE_WEIGHT=1
         GROUP BY IC.ITEM_ID, IC.VARIABLE_WEIGHT) PV
    ON PV.ITEM_ID=DI.ITEM_ID
    GROUP BY
        DI.ITEM_ID, DI.ITEM_NAME, DI.COMPRADOR, DI.ITEM, DI.PRODUCT_CLASS_ID, DI.BASE_UOM, DI.QTY_UOM,
        DI.CATEGORIA, DI.SHELF_DAYS, CASE WHEN DI.VARIABLE_WEIGHT=1 THEN PV.EMB_PS_VAR ELSE DI.EMB_FINAL END,
        DI.BASE, DI.ALTURA, DI.PALETIZACAO
    ) DADOS_ITEM)
        ON DADOS_ITEM.ITEM_ID=PTT.ITEM_ID
    LEFT JOIN SYS_CODE SC ON PTT.TH_INVN_TYPE=SC.CODE_ID AND SC.CODE_TYPE=&apos;064&apos;
    ) PROD)
    GROUP BY
         PROD.DT_SEP, PROD.HORA, PROD.TURNO, PROD.OPE, PROD.USER_ID, PROD.INVN_TYPE, PROD.WHSE, PROD.CODE_DESC, PROD.CATEGORIA
    ORDER BY
         PROD.DT_SEP, PROD.USER_ID, PROD.TURNO, PROD.HORA
    ) PRD_WMS)
    LEFT JOIN
       (SELECT
            B_FINAL.DT_PROD,
            B_FINAL.&quot;ATIVIDADE&quot;,
            B_FINAL.&quot;USUÁRIO&quot;,
            B_FINAL.&quot;COLABORADOR&quot;,
            B_FINAL.&quot;TURNO&quot;,
            B_FINAL.EMPRESA,
            B_FINAL.&quot;ENCARREGADO&quot;,     
            SUM(B_FINAL.&quot;QUANTIDADE&quot;) AS &quot;QUANTIDADE&quot;,
            ROUND(SUM(B_FINAL.&quot;MINUTOS&quot;)/60,2) AS &quot;MINUTOS&quot;,
            CASE WHEN SUM(B_FINAL.&quot;MINUTOS&quot;) &gt; 0 THEN ROUND((60*(SUM(B_FINAL.&quot;QUANTIDADE&quot;)/(SUM(B_FINAL.&quot;MINUTOS&quot;)))),0) ELSE 0 END AS PRODUTIVIDADE
        FROM
        (SELECT    
            TRUNC(ECPF.CLOCK_IN_DATE) AS DT_PROD,
            ECPF.LEVEL_2 as &quot;ATIVIDADE&quot;,
            ECPF.LOGIN_USER_ID as &quot;USUÁRIO&quot;,
            UU.USER_FIRST_NAME||&apos; &apos;||USER_LAST_NAME as &quot;COLABORADOR&quot;,
            ECPF.SHIFT_CODE AS &quot;TURNO&quot;,
            CASE WHEN ECPF.SHIFT_CODE IS NOT NULL THEN SUBSTR(ECPF.SHIFT_CODE,3,3) ELSE NULL END AS EMPRESA,
            ECPF.SPVSR_LOGIN_USER_ID AS &quot;ENCARREGADO&quot;,
            ECPF.TOTAL_TIME AS &quot;MINUTOS&quot;,
            ECPF.DISPLAY_UOM_QTY AS &quot;QUANTIDADE&quot;,
            CASE WHEN ECPF.LEVEL_2 IN(&apos;ARMAZENAR&apos;,&apos;RESSUPRIMENTO&apos;,&apos;PUXADA RECEB&apos;)
                 AND (ECPF.DISPLAY_UOM&lt;&gt;&apos;ILPN&apos; AND ECPF.DISPLAY_UOM IS NOT NULL) THEN &apos;N&apos; ELSE &apos;S&apos; END AS FILTRO   
        FROM E_CONSOL_PERF_SMRY ECPF    
        JOIN UCL_USER UU ON ECPF.LOGIN_USER_ID = UU.USER_NAME
        WHERE ECPF.CLOCK_IN_STATUS&lt;90 
          AND ECPF.EMP_PERF_SMRY_ID IS NOT NULL 
          AND ECPF.JOB_FUNCTION_NAME NOT IN (&apos;ALMOÇO/JANTA&apos;,&apos;ALMOCO/JANTA&apos;)
          AND ECPF.LEVEL_2 IS NOT NULL
        ) B_FINAL
        WHERE B_FINAL.FILTRO=&apos;S&apos;
          AND B_FINAL.ATIVIDADE=&apos;SEPARACAO&apos;
        GROUP BY
            B_FINAL.DT_PROD, B_FINAL.&quot;ATIVIDADE&quot;, B_FINAL.&quot;USUÁRIO&quot;, B_FINAL.&quot;COLABORADOR&quot;,
            B_FINAL.EMPRESA, B_FINAL.&quot;TURNO&quot;, B_FINAL.&quot;ENCARREGADO&quot;
        ORDER BY B_FINAL.DT_PROD   
       ) PRDTY_LABOR
    ON PRDTY_LABOR.DT_PROD=PRD_WMS.DT_SEP
   AND PRDTY_LABOR.&quot;USUÁRIO&quot;=PRD_WMS.USER_ID
    ) PRO_FINAL)
    JOIN UCL_USER UU ON PRO_FINAL.USER_ID= UU.USER_NAME
    LEFT JOIN
        (SELECT
             F.FACILITY_ID,
             FA.FACILITY_ALIAS_ID AS CD,
             F.WHSE,
             SC.CODE_ID AS INVN_TYPE
        FROM FACILITY F
        JOIN FACILITY_ALIAS FA ON F.FACILITY_ID=FA.FACILITY_ID
        JOIN SYS_CODE SC ON SC.SHORT_DESC = FA.FACILITY_ALIAS_ID
                         AND SC.CODE_TYPE = &apos;064&apos;
        WHERE F.WHSE IS NOT NULL AND F.WHSE &lt;&gt;&apos;01&apos;
        ) CD
    ON CD.INVN_TYPE=PRO_FINAL.INVN_TYPE
    ) A)
    GROUP BY   
        A.USER_ID,
        A.COLABORADOR,
        A.TURNO,
        A.OPE,
        A.OPERACAO
    ORDER BY 5 
    ) A)
    ) B)
) C)
LEFT JOIN
((SELECT
    TEMPO.USER_ID,
    TEMPO.DIA,
    TEMPO.HORA,
    TEMPO.MINUTOS,
    (TEMPO.DIA*1440)+(TEMPO.HORA*60)+TEMPO.MINUTOS AS TEMPO
FROM
((SELECT
    A.USER_ID,
    UPPER (UC.USER_FIRST_NAME ||&apos; &apos;|| UC.USER_LAST_NAME) AS &quot;COLABORADOR(A)&quot;,
    TO_CHAR(MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;),&apos;DD/MM/YYYY HH24:MI:SS&apos;) AS &quot;DATA SEPARAÇÃO&quot;,
    TO_CHAR(SYSDATE,&apos;DD/MM/YYYY HH24:MI:SS&apos;) AS &quot;DATA ATUAL&quot;,
    EXTRACT(DAY FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) AS DIA,
    EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) AS HORA,
    EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) AS MINUTOS,
    CASE 
        WHEN LENGTH(EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))&lt;2 
         AND LENGTH(EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))&lt;2 THEN
            &apos;0&apos;||EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) || &apos;:0&apos;||EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;)))
        WHEN LENGTH(EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))&lt;2 
         AND LENGTH(EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))=2 THEN
            &apos;0&apos;||EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) || &apos;:&apos;||EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;)))
        WHEN LENGTH(EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))=2 
         AND LENGTH(EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))))&lt;2 THEN
            EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) || &apos;:0&apos;||EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;)))
        ELSE
            EXTRACT(HOUR FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;))) || &apos;:&apos; || EXTRACT(MINUTE FROM (SYSDATE - MAX(A.&quot;DATA HORA SEPARAÇÃO&quot;)))
    END AS TEMPO
FROM    
((SELECT            
        CASE
          WHEN CAST(TO_CHAR(PTT.CREATE_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN TRUNC(PTT.CREATE_DATE_TIME)-1
          ELSE TRUNC(PTT.CREATE_DATE_TIME)    
        END AS DT_SEP,
        CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) AS HORA,
        CASE WHEN PTT.TH_INVN_TYPE = &apos;H&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt;=22 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;MI&apos;) AS FLOAT)&gt;30 THEN 3 
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt;=23 THEN 3 
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;12 THEN 1        
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&gt;=12 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;13 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;MI&apos;) AS FLOAT)&lt;=45 THEN 1                    
            ELSE 2 END
        WHEN PTT.TH_INVN_TYPE = &apos;J&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 6 AND CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 18 THEN 1
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &gt;= 22 OR CAST(TO_CHAR(PTT.MOD_DATE_TIME, &apos;HH24&apos;) AS FLOAT) &lt; 6 THEN 3
            ELSE NULL END
        ELSE
            CASE
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT) &gt; 21 THEN 3     
                WHEN CAST(TO_CHAR(PTT.MOD_DATE_TIME,&apos;HH24&apos;) AS FLOAT)&lt;14 THEN 1        
            ELSE 2 END 
        END AS TURNO,
        CASE WHEN PTT.TH_INVN_TYPE = &apos;H&apos; THEN
            CASE
                WHEN CAST(TO_CHAR(SYSDATE,&apos;HH24&apos;) AS FLOAT)&lt;6 THEN 3
